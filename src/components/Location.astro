---
import Icon from "./Icon.astro";
---

<section class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs space-y-3">
  <div class="flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
        <Icon name="location_on" class="text-[19px]" />
      </div>
      <div>
        <h4 class="font-headline text-[14px] font-bold text-light-primary leading-tight">
          Taller en Villa los Arregladores
        </h4>
        <span class="text-[11px] text-steel">
          Psj. Argomedo 1812, San Fernando
        </span>
      </div>
    </div>

    <a
      href="https://maps.google.com/?q=Psj.+Argomedo+1812,+San+Fernando,+Chile"
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] font-headline font-bold text-blue-600 flex items-center gap-0.5 bg-blue-50 px-2 py-1 rounded"
    >
      <span>Maps</span>
      <Icon name="open_in_new" class="text-[13px]" />
    </a>
  </div>

  <div class="relative h-36 rounded-2xl overflow-hidden border border-slate-200">
    <iframe
      title="Ubicación de Taller el Castillo"
      width="100%"
      height="100%"
      class="w-full h-full border-0"
      loading="lazy"
      src="https://maps.google.com/maps?q=Psj.+Argomedo+1812,+San+Fernando,+Chile&t=&z=15&ie=UTF8&iwloc=&output=embed"
    ></iframe>
  </div>
</section>
