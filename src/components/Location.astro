---
import Icon from"./Icon.astro";
---

<section id="ubicacion" class="md:py-16">
  <!-- Mobile -->
  <div class="md:hidden mb-5">
    <div class="flex items-center gap-2 mb-0.5 -ml-3">
      <span class="w-1 h-5 rounded-full bg-blue-500"></span>
      <h2 class="font-headline text-lg font-bold text-light-primary leading-tight">
        Ubicación del taller
      </h2>
    </div>
    <p class="text-sm text-slate-500">
      Taller equipado para revisiones y diagnósticos.
    </p>
  </div>

  <div class="md:hidden bg-white border border-slate-200 rounded-2xl p-4 shadow-xs space-y-3">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
          <Icon name="location_on" class="text-xl" />
        </div>
        <span class="text-xs text-steel">
          Pje. Angamos 1812, San Fernando
        </span>
      </div>

      <a
        href="https://maps.google.com/?q=Pje.+Angamos+1812,+San+Fernando,+Chile"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-headline font-bold text-blue-600 flex items-center gap-0.5 bg-blue-50 px-2 py-1 rounded"
      >
        <span>Maps</span>
        <Icon name="open_in_new" class="text-sm" />
      </a>
    </div>

    <div class="relative h-36 rounded-2xl overflow-hidden border border-slate-200">
      <iframe
        title="Ubicación de Taller el Castillo"
        width="100%"
        height="100%"
        class="w-full h-full border-0"
        loading="lazy"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3285.4391086266983!2d-70.9982261!3d-34.567754199999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x96649aac44246693%3A0x6dcdca5507fe4239!2sPje.%20Angamos%201812%2C%203072556%20San%20Fernando%2C%20O%27Higgins!5e0!3m2!1ses-419!2scl!4v1794954954473!5m2!1ses-419!2scl"
      ></iframe>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:block">
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-5 p-8 md:p-10 space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-2 mb-1.5 -ml-3">
              <span class="w-1 h-5 rounded-full bg-blue-500"></span>
              <h2 class="font-headline text-2xl font-bold text-light-primary">
                Ubicación del taller
              </h2>
            </div>

            <p class="text-steel text-body-sm leading-relaxed">
              Taller equipado para revisiones y diagnósticos. Punto de salida
              para la atención a domicilio en San Fernando y alrededores.
            </p>

            <div class="space-y-3 pt-2 text-body-sm">
              <div class="flex items-start gap-3">
                <Icon name="location_on" class="text-accent text-xl mt-0.5" />
                <div>
                  <strong class="text-light-primary block">
                    Dirección del taller:
                  </strong>
                  <span class="text-steel">
                    Pje. Angamos 1812, San Fernando, Chile
                  </span>
                </div>
              </div>
            </div>
          </div>

          <a
            href="https://maps.google.com/?q=Pje.+Angamos+1812,+San+Fernando,+Chile"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-light-primary hover:bg-light-secondary text-white font-headline text-sm font-bold rounded transition-colors w-fit"
          >
            <Icon name="open_in_new" class="text-lg" />
            <span>Abrir en Google Maps</span>
          </a>
        </div>

        <div class="lg:col-span-7 relative min-h-85 bg-slate-100 border-t lg:border-t-0 lg:border-l border-slate-200">
          <iframe
            title="Ubicación Taller el Castillo"
            width="100%"
            height="100%"
            class="w-full h-full min-h-95 border-0"
            loading="lazy"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3285.4391086266983!2d-70.9982261!3d-34.567754199999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x96649aac44246693%3A0x6dcdca5507fe4239!2sPje.%20Angamos%201812%2C%203072556%20San%20Fernando%2C%20O%27Higgins!5e0!3m2!1ses-419!2scl!4v1794954954473!5m2!1ses-419!2scl"
          ></iframe>

          <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-xs px-3.5 py-2 rounded shadow-sm border border-slate-200 text-xs flex items-center gap-2 text-light-primary font-medium pointer-events-none">
            <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
            <span>Taller Mecánica el Castillo</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
