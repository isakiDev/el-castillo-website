---
import Icon from "./Icon.astro";
---

<section class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs space-y-3">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
        <Icon name="location_on" class="text-[19px]" />
      </div>
      <div>
        <h4 class="font-headline text-[14px] font-bold text-light-primary leading-tight">
          Taller en Villa los Arregladores
        </h4>
        <span class="text-[11px] text-steel">
          Psj. Argomedo 1812, San Fernando
        </span>
      </div>
    </div>
  </div>

  <div class="relative h-36 rounded-2xl overflow-hidden border border-slate-200">
    <iframe
      title="Ubicación de Taller el Castillo"
      width="100%"
      height="100%"
      class="w-full h-full border-0"
      loading="lazy"
      src="https://maps.google.com/maps?q=Pje.+Angamos+1812,+San+Fernando,+O%27Higgins,+Chile&t=&z=15&ie=UTF8&iwloc=&output=embed"
    ></iframe>
  </div>

  <!-- <div class="flex items-center justify-between text-[11px] text-steel pt-1">
    <span>Lun a Vie 8:00 - 19:00</span>
    <span>Sáb 8:30 - 13:30</span>
  </div> -->
</section>
