---
import Icon from "./Icon.astro";
---

<section id="ubicacion" class="md:py-16">
  <!-- Mobile -->
  <div class="md:hidden bg-white border border-slate-200 rounded-2xl p-4 shadow-xs space-y-3">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
          <Icon name="location_on" class="text-[19px]" />
        </div>
        <div>
          <h4 class="font-headline text-[14px] font-bold text-light-primary leading-tight">
            Taller en Villa los Arregladores
          </h4>
          <span class="text-[11px] text-steel">
            Psj. Argomedo 1812, San Fernando
          </span>
        </div>
      </div>

      <a
        href="https://maps.google.com/?q=Psj.+Argomedo+1812,+San+Fernando,+Chile"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[11px] font-headline font-bold text-blue-600 flex items-center gap-0.5 bg-blue-50 px-2 py-1 rounded"
      >
        <span>Maps</span>
        <Icon name="open_in_new" class="text-[13px]" />
      </a>
    </div>

    <div class="relative h-36 rounded-2xl overflow-hidden border border-slate-200">
      <iframe
        title="Ubicación de Taller el Castillo"
        width="100%"
        height="100%"
        class="w-full h-full border-0"
        loading="lazy"
        src="https://maps.google.com/maps?q=Psj.+Argomedo+1812,+San+Fernando,+Chile&t=&z=15&ie=UTF8&iwloc=&output=embed"
      ></iframe>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:block">
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-5 p-8 md:p-10 space-y-6 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 font-code text-[12px] uppercase font-bold tracking-wider rounded-full border border-blue-200">
              <Icon name="location_on" class="text-[16px]" />
              Punto de Atención
            </span>

            <h2 class="font-headline text-[20px] md:text-[24px] font-bold text-light-primary">
              Taller en Villa los Arregladores
            </h2>

            <p class="text-steel text-body-sm leading-relaxed">
              Taller equipado para revisiones y diagnósticos. Punto de salida
              para la atención a domicilio en San Fernando y alrededores.
            </p>

            <div class="space-y-3 pt-2 text-body-sm">
              <div class="flex items-start gap-3">
                <Icon
                  name="location_on"
                  class="text-accent text-[20px] mt-0.5"
                />
                <div>
                  <strong class="text-light-primary block">
                    Dirección del taller:
                  </strong>
                  <span class="text-steel">
                    Psj. Argomedo 1812, San Fernando, Chile
                  </span>
                </div>
              </div>
            </div>
          </div>

          <a
            href="https://maps.google.com/?q=Psj.+Argomedo+1812,+San+Fernando,+Chile"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-light-primary hover:bg-light-secondary text-white font-headline text-[13px] font-bold rounded transition-colors w-fit"
          >
            <Icon name="open_in_new" class="text-[18px]" />
            <span>Abrir en Google Maps</span>
          </a>
        </div>

        <div class="lg:col-span-7 relative min-h-[340px] bg-slate-100 border-t lg:border-t-0 lg:border-l border-slate-200">
          <iframe
            title="Ubicación Taller el Castillo"
            width="100%"
            height="100%"
            class="w-full h-full min-h-[380px] border-0"
            loading="lazy"
            src="https://maps.google.com/maps?q=Psj.+Argomedo+1812,+San+Fernando,+Chile&t=&z=15&ie=UTF8&iwloc=&output=embed"
          ></iframe>

          <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-xs px-3.5 py-2 rounded shadow-sm border border-slate-200 text-[12px] flex items-center gap-2 text-light-primary font-medium pointer-events-none">
            <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
            <span>Taller Mecánica el Castillo</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
