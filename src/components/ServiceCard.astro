---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  iconClass: string;
  badge: string;
  badgeClass: string;
  meta: string;
  title: string;
  description: string;
  benefit: string;
  href: string;
}

const {
  icon,
  iconClass,
  badge,
  badgeClass,
  meta,
  title,
  description,
  benefit,
  href,
} = Astro.props;
---

<article class="bg-white border border-slate-200 rounded-xl p-3.5 shadow-xs space-y-2.5">
  <div class="flex items-start gap-3">
    <div
      class={`w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 border ${iconClass}`}
    >
      <Icon name={icon} class="text-[22px]" />
      <icon />
    </div>
    <div class="flex-1">
      <div class="flex items-center justify-between">
        <span
          class={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${badgeClass}`}
        >
          {badge}
        </span>
        <span class="text-[11px] font-code text-steel">{meta}</span>
      </div>
      <h4 class="font-headline text-[14px] font-bold text-light-primary mt-1">
        {title}
      </h4>
      <p class="text-[12px] text-steel mt-0.5 leading-snug">{description}</p>
    </div>
  </div>

  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-[12px]">
    <span class="text-slate-600 flex items-center gap-1">
      <Icon name="check" class="text-[15px] text-whatsapp" />
      {benefit}
    </span>
    <a
      href={href}
      class="text-light-primary hover:text-accent font-headline font-bold inline-flex items-center gap-1 text-[12px]"
    >
      Consultar
      <Icon name="arrow_forward" class="text-[14px]" />
    </a>
  </div>
</article>
