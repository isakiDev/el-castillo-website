---
import Icon from "./Icon.astro";

interface Props {
  icon: string;
  iconClass: string;
  badge: string;
  badgeClass: string;
  meta: string;
  title: string;
  description: string;
  benefit: string;
  href: string;
}

const {
  icon,
  iconClass,
  badge,
  badgeClass,
  meta,
  title,
  description,
  benefit,
  href,
} = Astro.props;
---

<article class="bg-white border border-slate-200 rounded-xl p-3.5 md:p-6 shadow-xs md:shadow-sm md:transition-all md:duration-200 md:hover:shadow-md md:flex md:flex-col md:justify-between md:group">
  <!-- Mobile -->
  <div class="md:hidden flex items-start gap-3">
    <div
      class={`w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 border ${iconClass}`}
    >
      <Icon name={icon} class="text-xl" />
    </div>

    <div class="flex-1">
      <div class="flex items-center justify-between">
        <span
          class={`text-xs font-semibold px-2 py-0.5 rounded-full ${badgeClass}`}
        >
          {badge}
        </span>
        <span class="text-xs font-code text-steel">{meta}</span>
      </div>
      <h3 class="font-headline text-sm font-bold text-light-primary mt-1">
        {title}
      </h3>
      <p class="text-xs text-steel py-2 leading-snug">{description}</p>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:block space-y-4">
    <div class="flex items-center justify-between">
      <div
        class={`w-12 h-12 rounded-lg flex items-center justify-center border ${iconClass} group-hover:scale-105 transition-transform`}
      >
        <Icon name={icon} class="text-2xl" />
      </div>
      <span
        class={`text-xs font-semibold font-code uppercase tracking-wider px-2.5 py-1 rounded-full border border-slate-200 ${badgeClass}`}
      >
        {badge}
      </span>
    </div>
    <div>
      <h3 class="font-headline font-bold text-lg text-light-primary mb-1">
        {title}
      </h3>
      <p class="text-steel text-sm leading-relaxed">{description}</p>
    </div>
  </div>

  <div class="pt-2.5 md:pt-4 md:mt-4 border-t border-slate-100 md:border-slate-200 flex items-center justify-between text-xs">
    <span class="text-slate-600 flex items-center gap-1">
      <Icon name="check" class="text-sm text-whatsapp" />
      {benefit}
    </span>
    <a
      href={href}
      class="text-light-primary hover:text-accent font-headline font-bold inline-flex items-center gap-1 text-xs"
    >
      Consultar
      <Icon name="arrow_forward" class="text-sm" />
    </a>
  </div>
</article>
