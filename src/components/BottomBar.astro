---
import Icon from "./Icon.astro";
---

<nav aria-label="Contacto rápido" class="fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 shadow-lg">
  <div class="max-w-md mx-auto flex items-center gap-2.5">
    <a
      href="tel:+56953377432"
      class="w-12 h-12 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-light-primary flex items-center justify-center shrink-0 border border-slate-200 transition-colors"
      aria-label="Llamar"
    >
      <Icon name="call" class="text-[20px]" />
    </a>

    <a
      href={`https://wa.me/56953377432?text=${encodeURIComponent(
        "Hola Gabriel, quisiera hacerte una consulta por mi auto.",
      )}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 h-12 rounded-xl bg-whatsapp hover:bg-whatsapp-hover active:scale-95 text-white font-headline text-[14px] font-bold flex items-center justify-center gap-2 shadow-sm transition-colors"
    >
      <Icon name="chat" class="text-[20px]" />
      <span>WhatsApp Directo</span>
    </a>
  </div>
</nav>
