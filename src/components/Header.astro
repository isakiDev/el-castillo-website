---
import Icon from "./Icon.astro";
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 shadow-xs">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="relative">
        <img
          src="https://i.pinimg.com/236x/90/9c/a1/909ca15303f4a1f0dd0a03101856011d.jpg"
          alt="El Castillo"
          class="w-10 h-10 rounded-full object-cover border border-slate-200 shadow-xs"
        />
        <!-- <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-500 border-2 border-white"></span> -->
      </div>

      <div>
        <div class="flex items-center gap-1">
          <h1 class="font-headline text-[15px] font-bold text-light-primary leading-tight">
            Mecánica el Castillo
          </h1>
          <Icon name="verified" class="text-[15px] text-blue-600" />
        </div>
        <p class="text-[12px] text-steel">
          Taller en Los Arregladores • A Domicilio
        </p>
      </div>
    </div>

    <!-- <div class="flex items-center gap-2">
      <a
        href="tel:+56953377432"
        class="w-9 h-9 rounded-full bg-slate-100 flex items-center justify-center text-light-primary border border-slate-200 hover:bg-slate-200 transition-colors"
        aria-label="Llamar"
      >
        <Icon name="call" class="text-[19px]" />
      </a>
    </div> -->
  </div>
</header>
