---
import Icon from "./Icon.astro";
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md md:backdrop-blur-none border-b border-slate-200/80 px-4 md:px-0 py-3 md:py-0 shadow-xs md:shadow-none">
  <div class="max-w-[1120px] mx-auto md:px-6 md:py-6 flex items-center justify-between gap-4">
    <div class="flex items-center gap-2.5">
      <img
        src="https://i.pinimg.com/236x/90/9c/a1/909ca15303f4a1f0dd0a03101856011d.jpg"
        alt="Mecánica el Castillo"
        class="w-10 h-10 rounded-full object-cover border border-slate-200 shadow-xs"
      />

      <div>
        <div class="flex items-center gap-1">
          <h1 class="font-headline text-[15px] font-bold text-light-primary leading-tight">
            Mecánica el Castillo
          </h1>
          <Icon name="verified" class="text-[15px] text-blue-600" />
        </div>
        <p class="text-[12px] text-steel">
          Taller en Los Arregladores • A Domicilio
        </p>
      </div>
    </div>

    <nav
      class="hidden md:flex items-center gap-8 text-body-sm text-steel"
      aria-label="Navegación secundaria"
    >
      <a href="#servicios" class="hover:text-light-primary transition-colors">
        Servicios
      </a>
      <a href="#proceso" class="hover:text-light-primary transition-colors">
        Cómo trabajo
      </a>
      <a href="#ubicacion" class="hover:text-light-primary transition-colors">
        Ubicación
      </a>
      <a href="#contacto" class="hover:text-light-primary transition-colors">
        Contacto
      </a>
    </nav>
  </div>
</header>
