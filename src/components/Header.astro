---
import Icon from "./Icon.astro";
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 shadow-xs">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <img
        src="https://i.pinimg.com/236x/90/9c/a1/909ca15303f4a1f0dd0a03101856011d.jpg"
        alt="El Castillo"
        class="w-10 h-10 rounded-full object-cover border border-slate-200 shadow-xs"
      />

      <div>
        <div class="flex items-center gap-1">
          <h1 class="font-headline text-[15px] font-bold text-light-primary leading-tight">
            Mecánica el Castillo
          </h1>
          <Icon name="verified" class="text-[15px] text-blue-600" />
        </div>
        <p class="text-[12px] text-steel">
          Taller en Los Arregladores • A Domicilio
        </p>
      </div>
    </div>
  </div>
</header>
