---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Location from "../components/Location.astro";
import Trust from "../components/Trust.astro";
import BottomBar from "../components/BottomBar.astro";
import Icon from "../components/Icon.astro";
---

<Layout>
  <Header />
  <main class="flex-1 w-full max-w-[1120px] mx-auto px-4 md:px-6 py-4 md:py-8 space-y-5 md:space-y-10">
    <Hero />
    <Services />
    <Process />
    <Location />
    <Trust />
    <section id="contacto" class="hidden md:block py-12 text-center">
      <div class="max-w-xl mx-auto space-y-6">
        <h2 class="font-headline text-[36px] md:text-[48px] leading-[1.15] text-light-primary font-bold tracking-tight">
          ¿Querés consultar por tu vehículo?
        </h2>
        <p class="text-steel text-body-md">
          Escribime detallando marca, modelo, año y el síntoma o servicio que
          necesitás. Te respondo personalmente a la brevedad.
        </p>
        <div class="pt-4 flex flex-wrap justify-center items-center gap-4">
          <a
            href={`https://wa.me/56953377432?text=${encodeURIComponent("Hola Gabriel, quisiera consultar por mi auto.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-whatsapp hover:bg-whatsapp-hover text-white font-headline text-[14px] font-bold rounded shadow-xs transition-colors"
          >
            <Icon name="chat" class="text-[22px]" />
            <span>Escribir por WhatsApp</span>
          </a>
          <a
            href="tel:+56953377432"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 border border-slate-300 hover:border-slate-800 text-light-primary font-headline text-[14px] font-bold rounded transition-colors"
          >
            <Icon name="call" class="text-[20px] text-steel" />
            <span>Llamar al +56 9 5337 7432</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <BottomBar />
</Layout>
